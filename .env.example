# OpenTrail Environment Configuration Template
# DO NOT COMMIT ACTUAL API KEYS OR SECRETS TO THIS FILE OR GIT

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Optional API Endpoints (Defaults use free public endpoints)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
MAP_TILE_SERVER_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
WIKIPEDIA_API_BASE_URL=https://en.wikipedia.org/w/api.php
REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1

# Logging level (debug, info, warning, error)
LOG_LEVEL=debug
