# Enforce LF line endings for text files
* text=auto eol=lf

*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.arb text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.kts text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
